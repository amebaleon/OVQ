{
  "benchmark_name": "nexus_ovq_l4_nf4_wikitext",
  "model_id": "TinyLlama/TinyLlama-1.1B-Chat-v1.0",
  "dtype": "float16",
  "seed": 42,
  "output_dir": "outputs/l4_nf4_wikitext",
  "max_sequence_length": 192,
  "ppl_max_length": 192,
  "ppl_stride": 192,
  "ppl_max_batches": 32,
  "ppl_dataset": {
    "name": "wikitext",
    "subset": "wikitext-2-raw-v1",
    "split": "test",
    "text_column": "text",
    "max_samples": 64
  },
  "generation_max_new_tokens": 64,
  "generation_repeats": 1,
  "use_chat_template_for_generation": true,
  "target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ],
  "layers": "all",
  "block_size": 16,
  "overlap_ratio": 0.5,
  "overlap_weight": "uniform",
  "metadata_mode": "group",
  "metadata_group_size": 256,
  "sensitivity_ranking": [1, 3, 8, 0, 10, 15, 14, 13, 12, 11, 6, 5, 4, 2, 7, 9],
  "methods": [
    {
      "name": "fp16_reference",
      "kind": "reference"
    },
    {
      "name": "bnb_nf4_double_quant",
      "kind": "bnb_nf4",
      "estimated_bpw": 4.5,
      "double_quant": true
    },
    {
      "name": "vq_2bit_window_meta",
      "kind": "vq",
      "bits": 2,
      "metadata_mode": "window"
    },
    {
      "name": "ovq_2bit_group_meta",
      "kind": "ovq",
      "bits": 2,
      "metadata_mode": "group",
      "metadata_group_size": 256
    },
    {
      "name": "mixed_ovq_top2_group_meta",
      "kind": "mixed_ovq",
      "base_bits": 2,
      "protected_bits": 4,
      "top_k": 2,
      "metadata_mode": "group",
      "metadata_group_size": 256
    },
    {
      "name": "mixed_ovq_top4_group_meta",
      "kind": "mixed_ovq",
      "base_bits": 2,
      "protected_bits": 4,
      "top_k": 4,
      "metadata_mode": "group",
      "metadata_group_size": 256
    },
    {
      "name": "mixed_ovq_top6_group_meta",
      "kind": "mixed_ovq",
      "base_bits": 2,
      "protected_bits": 4,
      "top_k": 6,
      "metadata_mode": "group",
      "metadata_group_size": 256
    },
    {
      "name": "mixed_ovq_top8_group_meta",
      "kind": "mixed_ovq",
      "base_bits": 2,
      "protected_bits": 4,
      "top_k": 8,
      "metadata_mode": "group",
      "metadata_group_size": 256
    }
  ],
  "eval_prompts": [
    "The capital of France is",
    "Artificial intelligence is",
    "Python is a",
    "The future of medicine will",
    "In a small village near the mountains",
    "A startup can reduce inference cost by",
    "The main risk of low bit quantization is",
    "A reliable benchmark should report"
  ],
  "generation_prompts": [
    "Explain why quantization is useful for running language models on small GPUs.",
    "Write a short answer about why privacy matters in on-premise AI.",
    "Give three practical risks when compressing a language model.",
    "Describe a business case for a lightweight language model company."
  ],
  "ppl_texts": [
    "Fallback text if WikiText2 loading fails."
  ],
  "optional_baselines": {
    "bitsandbytes_nf4": true,
    "gptq": false,
    "awq": false
  }
}
